# Multi-stage build for production
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
npm ci

# Copy source
COPY . .

# Build if needed


# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Copy only production artifacts
COPY --from=builder /app .

# Non-root user
USER 1000:1000

EXPOSE 3000

CMD ["node index.js"]
