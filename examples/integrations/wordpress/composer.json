{
    "name": "rilavo/verification",
    "description": "Rilavo Agent Verification for WordPress",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "rilavo/sdk": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Rilavo\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=WordPress src/",
        "cs-fix": "phpcbf --standard=WordPress src/"
    }
}
