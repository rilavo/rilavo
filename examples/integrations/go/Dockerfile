# Generated by `rilavo init --framework go`
# Multi-stage build for production
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install dependencies
go mod download

# Copy source
COPY . .

# Build if needed
go build -o app .

# Production stage
FROM golang:1.22-alpine AS production

WORKDIR /app

# Copy only production artifacts
COPY --from=builder /app/app .

# Non-root user
USER 1000:1000

EXPOSE 8080

CMD ["./app"]
