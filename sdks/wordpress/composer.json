{
    "name": "rilavo/verification",
    "description": "Rilavo Agent Verification for WordPress",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=7.2",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Rilavo\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=WordPress includes/",
        "cs-fix": "phpcbf --standard=WordPress includes/"
    },
    "suggest": {
        "open-telemetry/sdk": "OpenTelemetry SDK for metrics and tracing",
        "open-telemetry/exporter-prometheus": "Prometheus exporter for OpenTelemetry",
        "rilavo/sdk": "Rilavo PHP SDK for advanced features"
    }
}